<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_hmx_attendance" model="ir.module.category">
        <field name="name">Asistencia HMX</field>
        <field name="sequence">30</field>
    </record>

    <record id="group_hmx_attendance_supervisor" model="res.groups">
        <field name="name">Supervisor de asistencia</field>
        <field name="category_id" ref="module_category_hmx_attendance"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Captura la asistencia diaria y sube los archivos del reloj checador.</field>
    </record>

    <record id="group_hmx_attendance_manager" model="res.groups">
        <field name="name">Gerente de asistencia</field>
        <field name="category_id" ref="module_category_hmx_attendance"/>
        <field name="implied_ids" eval="[(4, ref('group_hmx_attendance_supervisor'))]"/>
        <field name="comment">Valida registros, administra el catálogo de incidencias y puede eliminar.</field>
    </record>

    <!-- Cada supervisor trabaja solo con sus propias sesiones de captura. -->
    <record id="rule_hmx_session_own" model="ir.rule">
        <field name="name">Sesiones de captura: solo propias</field>
        <field name="model_id" ref="model_hmx_attendance_session"/>
        <field name="domain_force">[('supervisor_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_hmx_attendance_supervisor'))]"/>
    </record>

    <record id="rule_hmx_session_manager_all" model="ir.rule">
        <field name="name">Sesiones de captura: gerente ve todas</field>
        <field name="model_id" ref="model_hmx_attendance_session"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_hmx_attendance_manager'))]"/>
    </record>

    <record id="rule_hmx_session_line_own" model="ir.rule">
        <field name="name">Líneas de sesión: solo de sesiones propias</field>
        <field name="model_id" ref="model_hmx_attendance_session_line"/>
        <field name="domain_force">[('session_id.supervisor_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_hmx_attendance_supervisor'))]"/>
    </record>

    <record id="rule_hmx_session_line_manager_all" model="ir.rule">
        <field name="name">Líneas de sesión: gerente ve todas</field>
        <field name="model_id" ref="model_hmx_attendance_session_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_hmx_attendance_manager'))]"/>
    </record>
</odoo>
